{
  "id": "chatbots",
  "name": "Chatbot Builder",
  "description": "Visitor-facing chatbots with their own persona and knowledge.",
  "enabledByDefault": true,
  "requires": [
    "chat"
  ],
  "capabilities": [
    "GET /chatbots",
    "POST /chatbots/session"
  ],
  "events": [
    "aicore.chatbots.created",
    "aicore.chatbots.updated"
  ],
  "permissions": [
    "aicore:chatbots:read",
    "aicore:chatbots:write"
  ]
}
