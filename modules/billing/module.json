{
  "id": "billing",
  "name": "Billing + Usage",
  "description": "Plans, quotas and usage-based limits.",
  "enabledByDefault": true,
  "requires": [
    "analytics"
  ],
  "capabilities": [
    "GET /billing/usage",
    "POST /billing/checkout"
  ],
  "events": [
    "aicore.billing.created",
    "aicore.billing.updated"
  ],
  "permissions": [
    "aicore:billing:read",
    "aicore:billing:write"
  ]
}
