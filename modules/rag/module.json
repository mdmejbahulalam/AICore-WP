{
  "id": "rag",
  "name": "Knowledge RAG",
  "description": "Index site content and answer from it with citations.",
  "enabledByDefault": true,
  "requires": [
    "memory"
  ],
  "capabilities": [
    "POST /rag/index",
    "POST /rag/search"
  ],
  "events": [
    "aicore.rag.created",
    "aicore.rag.updated"
  ],
  "permissions": [
    "aicore:rag:read",
    "aicore:rag:write"
  ]
}
