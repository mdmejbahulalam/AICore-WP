{
  "id": "chat",
  "name": "AI Chat Center",
  "description": "Conversational assistant with history and tool calling.",
  "enabledByDefault": true,
  "requires": [],
  "capabilities": [
    "GET /chat/conversations",
    "POST /chat/conversations",
    "GET /chat/conversations/{id}",
    "POST /chat/conversations/{id}/messages",
    "POST /chat/conversations/{id}/stream"
  ],
  "events": [
    "aicore.chat.created",
    "aicore.chat.updated"
  ],
  "permissions": [
    "aicore:chat:read",
    "aicore:chat:write"
  ]
}
