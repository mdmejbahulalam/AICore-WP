{
  "id": "agents",
  "name": "Multi-Agent System",
  "description": "Agents that plan and call tools.",
  "enabledByDefault": true,
  "requires": [
    "chat"
  ],
  "capabilities": [
    "GET /agents",
    "POST /agents/delegate"
  ],
  "events": [
    "aicore.agents.created",
    "aicore.agents.updated"
  ],
  "permissions": [
    "aicore:agents:read",
    "aicore:agents:write"
  ]
}
